local function showNotif(text, color)
    notif.Text = text
    notif.TextColor3 = color or Theme.Text
    if color == Theme.Success or color == Theme.Error then
        task.delay(3, function()
            if notif and notif.Parent then
                notif.Text = "Pilih script di atas. (Rekomendasi: Kira Hub)"
                notif.TextColor3 = Theme.TextMuted
            end
        end)
    end
end

